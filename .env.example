# ==============================================================================
#  معروضك — متغيرات البيئة
#
#  انسخ هذا الملف إلى .env وعبّئ القيم. لا تُودِع .env في Git إطلاقاً.
#  الشرح الكامل لكل متغيّر: docs/ENVIRONMENT.md
# ==============================================================================


# ------------------------------------------------------------------------------
#  البيئة
# ------------------------------------------------------------------------------
# development | staging | production
# منفصل عن NODE_ENV عمداً: Next.js يضبط NODE_ENV=production حتى في البناء
# المحلي، فلا يصلح للتمييز بين staging والإنتاج.
APP_ENV="development"
NODE_ENV="development"


# ------------------------------------------------------------------------------
#  النطاق  (مطلوب)
# ------------------------------------------------------------------------------
# مصدر الحقيقة الوحيد للنطاق: الروابط المعيارية، خريطة الموقع، OpenGraph،
# فحص Origin. لا نطاق مكتوب داخل الشيفرة.
#
# ⚠️ يُدمج في حزمة المتصفح وقت البناء — تغييره يتطلب إعادة بناء لا إعادة تشغيل.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# بريد الدعم المعروض في التذييل وسياسة الخصوصية. ليس سرّاً.
NEXT_PUBLIC_SUPPORT_EMAIL="support@maroudak.sa"

# تجاوز اختياري للخادم فقط، حين يختلف العنوان الداخلي عن العام (خلف وكيل).
# اتركه فارغاً في الحالة المعتادة.
APP_URL=""

# توحيد النطاق:  www  →  example.com يُحوَّل إلى www.example.com
#                apex →  www.example.com يُحوَّل إلى example.com
#                none →  بلا تحويل (مناسب للتطوير ولمنصات تتولّاه بنفسها)
CANONICAL_HOST_MODE="none"

# أصول إضافية مسموح بها في CORS، مفصولة بفواصل. اتركه فارغاً عادةً.
ALLOWED_ORIGINS=""


# ------------------------------------------------------------------------------
#  قاعدة البيانات  (مطلوب)
# ------------------------------------------------------------------------------
# محلياً: شغّل `npm run db:start` واستخدم الرابط كما هو.
# إنتاجياً: رابط PostgreSQL المُدار — أضف ?sslmode=require إن تطلّبه المزوّد.
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/maroudak?schema=public"

# قاعدة اختبارات التكامل — تُعاد تهيئتها في كل تشغيل. للتطوير فقط.
DATABASE_URL_TEST="postgresql://postgres:postgres@localhost:5433/maroudak_test?schema=public"


# ------------------------------------------------------------------------------
#  الجلسات  (مطلوب)
# ------------------------------------------------------------------------------
# 32 حرفاً على الأقل. ولّد قيمة جديدة لكل بيئة:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
#
# ملاحظة لمن يبحث عن NEXTAUTH_SECRET: المشروع لا يستخدم NextAuth
# (docs/DECISIONS.md #D-005). هذا المتغيّر يؤدي الدور نفسه.
SESSION_SECRET="change-me-to-a-long-random-string-at-least-32-chars"


# ------------------------------------------------------------------------------
#  الذكاء الاصطناعي
# ------------------------------------------------------------------------------
# مفتاح Anthropic. يبقى على الخادم حصراً — لا يُقرأ في أي كود عميل.
# بدونه تعمل المنصة بكل شيء عدا التوليد، وتُرجع رسالة عربية واضحة.
ANTHROPIC_API_KEY=""


# ------------------------------------------------------------------------------
#  التخزين
# ------------------------------------------------------------------------------
# local | s3
# ⚠️ `local` مرفوض في staging والإنتاج: الحاويات لها نظام ملفات مؤقت وغير
# مشترك، فالملف يختفي عند إعادة النشر. التطبيق يفشل عند الإقلاع إن حاولت.
STORAGE_DRIVER="local"

# متوافق مع S3: AWS S3 · Cloudflare R2 · DigitalOcean Spaces · MinIO
STORAGE_ENDPOINT=""
STORAGE_REGION="auto"
STORAGE_BUCKET=""
STORAGE_ACCESS_KEY_ID=""
STORAGE_SECRET_ACCESS_KEY=""

# أصل عام للملفات (CDN أو نطاق الحاوية). اختياري.
STORAGE_PUBLIC_URL=""


# ------------------------------------------------------------------------------
#  السجلات والمراقبة
# ------------------------------------------------------------------------------
# debug | info | warn | error
LOG_LEVEL="info"

# رمز خدمة رصد الأخطاء — اختياري.
SENTRY_DSN=""


# ------------------------------------------------------------------------------
#  البريد  (اختياري في v1)
# ------------------------------------------------------------------------------
# بدون SMTP_URL تُطبع روابط استعادة كلمة المرور في سجل الخادم أثناء التطوير.
MAIL_FROM="no-reply@maroudak.sa"
SMTP_URL=""
